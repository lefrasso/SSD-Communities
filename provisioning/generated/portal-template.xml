<?xml version="1.0" encoding="utf-8"?>
<pnp:Provisioning xmlns:pnp="http://schemas.dev.office.com/PnP/2022/09/ProvisioningSchema">
  <pnp:Preferences Generator="SSD Communities schema generator" />
  <pnp:Templates ID="SSD-COMMUNITIES-TEMPLATES">
    <pnp:ProvisioningTemplate ID="SSD-COMMUNITIES-V1" Version="1">
      <pnp:Lists>
        <pnp:ListInstance Title="Communities" Description="The community register: scope, family, channels, status." TemplateType="100" Url="Lists/Communities" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Choice" Name="ServiceFamily" StaticName="ServiceFamily" DisplayName="Service Family" Required="FALSE" Indexed="TRUE"><Description>Tenant-defined service family</Description><CHOICES><CHOICE>Azure</CHOICE><CHOICE>Data &amp; AI</CHOICE><CHOICE>Modern Work</CHOICE><CHOICE>Security</CHOICE><CHOICE>Business Applications</CHOICE><CHOICE>Cross-community</CHOICE></CHOICES></Field>
            <Field Type="Note" Name="ScopeInScope" StaticName="ScopeInScope" DisplayName="Scope In Scope" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"></Field>
            <Field Type="Note" Name="ScopeOutOfScope" StaticName="ScopeOutOfScope" DisplayName="Scope Out Of Scope" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"><Description>Drives overlap review</Description></Field>
            <Field Type="Text" Name="VivaEngageGroupId" StaticName="VivaEngageGroupId" DisplayName="Viva Engage Group Id" Required="FALSE" Indexed="FALSE"><Description>Backing M365 group id</Description></Field>
            <Field Type="URL" Name="VivaEngageUrl" StaticName="VivaEngageUrl" DisplayName="Viva Engage Url" Required="FALSE" Indexed="FALSE" Format="Hyperlink"></Field>
            <Field Type="URL" Name="ChatGroupUrl" StaticName="ChatGroupUrl" DisplayName="Chat Group Url" Required="FALSE" Indexed="FALSE" Format="Hyperlink"></Field>
            <Field Type="MultiChoice" Name="TargetRoles" StaticName="TargetRoles" DisplayName="Target Roles" Required="FALSE" Indexed="FALSE"><CHOICES><CHOICE>Community Lead</CHOICE><CHOICE>Family Owner (SME)</CHOICE><CHOICE>Invited Expert</CHOICE></CHOICES></Field>
            <Field Type="Boolean" Name="IsCrossCommunity" StaticName="IsCrossCommunity" DisplayName="Is Cross Community" Required="FALSE" Indexed="FALSE"></Field>
            <Field Type="Choice" Name="Status" StaticName="Status" DisplayName="Status" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Proposed</CHOICE><CHOICE>Chartered</CHOICE><CHOICE>Active</CHOICE><CHOICE>Merged</CHOICE><CHOICE>Retired</CHOICE></CHOICES></Field>
            <Field Type="DateTime" Name="LaunchDate" StaticName="LaunchDate" DisplayName="Launch Date" Required="FALSE" Indexed="FALSE" Format="DateOnly"><Description>Anchors the health baseline period</Description></Field>
          </pnp:Fields>
        </pnp:ListInstance>
        <pnp:ListInstance Title="Community Roles" Description="Named people and their role in a community." TemplateType="100" Url="Lists/CommunityRoles" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Lookup" Name="Community" StaticName="Community" DisplayName="Community" Required="TRUE" Indexed="TRUE" List="{listid:Communities}" ShowField="Title"></Field>
            <Field Type="User" Name="Person" StaticName="Person" DisplayName="Person" Required="TRUE" Indexed="FALSE" UserSelectionMode="PeopleOnly" UserSelectionScope="0"><Description>Resolves against Entra; never free text</Description></Field>
            <Field Type="Choice" Name="Role" StaticName="Role" DisplayName="Role" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Community Lead</CHOICE><CHOICE>Family Owner (SME)</CHOICE><CHOICE>Invited Expert</CHOICE></CHOICES></Field>
            <Field Type="Choice" Name="TimeZone" StaticName="TimeZone" DisplayName="Time Zone" Required="FALSE" Indexed="TRUE"><Description>Required for Family Owners</Description><CHOICES><CHOICE>AMER</CHOICE><CHOICE>EMEA</CHOICE><CHOICE>APAC</CHOICE></CHOICES></Field>
            <Field Type="Choice" Name="SourceOrg" StaticName="SourceOrg" DisplayName="Source Org" Required="TRUE" Indexed="FALSE"><CHOICES><CHOICE>IP Dev Team</CHOICE><CHOICE>CSAM Strategy Org</CHOICE><CHOICE>Adoption</CHOICE><CHOICE>Delivery</CHOICE></CHOICES></Field>
            <Field Type="Boolean" Name="Active" StaticName="Active" DisplayName="Active" Required="FALSE" Indexed="FALSE"></Field>
          </pnp:Fields>
        </pnp:ListInstance>
        <pnp:ListInstance Title="Charters" Description="The charter record and its sign-off state; one per community." TemplateType="100" Url="Lists/Charters" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Lookup" Name="Community" StaticName="Community" DisplayName="Community" Required="TRUE" Indexed="TRUE" EnforceUniqueValues="TRUE" List="{listid:Communities}" ShowField="Title"></Field>
            <Field Type="Note" Name="InteractionModel" StaticName="InteractionModel" DisplayName="Interaction Model" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"></Field>
            <Field Type="Text" Name="Cadence" StaticName="Cadence" DisplayName="Cadence" Required="FALSE" Indexed="FALSE"></Field>
            <Field Type="Note" Name="ReadinessPlan" StaticName="ReadinessPlan" DisplayName="Readiness Plan" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"></Field>
            <Field Type="MultiChoice" Name="LaunchReadiness" StaticName="LaunchReadiness" DisplayName="Launch Readiness" Required="FALSE" Indexed="FALSE"><Description>The six readiness conditions</Description><CHOICES><CHOICE>Scope approved</CHOICE><CHOICE>Community roles assigned</CHOICE><CHOICE>Viva Engage and chat channels ready</CHOICE><CHOICE>Interaction model and cadence agreed</CHOICE><CHOICE>Readiness plan agreed</CHOICE><CHOICE>Health baseline captured</CHOICE></CHOICES></Field>
            <Field Type="Choice" Name="Status" StaticName="Status" DisplayName="Status" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Draft</CHOICE><CHOICE>In review</CHOICE><CHOICE>Signed off</CHOICE></CHOICES></Field>
            <Field Type="User" Name="SignOffLead" StaticName="SignOffLead" DisplayName="Sign Off Lead" Required="FALSE" Indexed="FALSE" UserSelectionMode="PeopleOnly" UserSelectionScope="0"></Field>
            <Field Type="DateTime" Name="SignOffLeadDate" StaticName="SignOffLeadDate" DisplayName="Sign Off Lead Date" Required="FALSE" Indexed="FALSE" Format="DateOnly"></Field>
            <Field Type="User" Name="SignOffPM" StaticName="SignOffPM" DisplayName="Sign Off PM" Required="FALSE" Indexed="FALSE" UserSelectionMode="PeopleOnly" UserSelectionScope="0"><Description>PM signature records the overlap review</Description></Field>
            <Field Type="DateTime" Name="SignOffPMDate" StaticName="SignOffPMDate" DisplayName="Sign Off PMDate" Required="FALSE" Indexed="FALSE" Format="DateOnly"></Field>
            <Field Type="User" Name="SignOffFamilyOwner" StaticName="SignOffFamilyOwner" DisplayName="Sign Off Family Owner" Required="FALSE" Indexed="FALSE" UserSelectionMode="PeopleOnly" UserSelectionScope="0"></Field>
            <Field Type="DateTime" Name="SignOffFamilyOwnerDate" StaticName="SignOffFamilyOwnerDate" DisplayName="Sign Off Family Owner Date" Required="FALSE" Indexed="FALSE" Format="DateOnly"></Field>
            <Field Type="Text" Name="CharterVersion" StaticName="CharterVersion" DisplayName="Charter Version" Required="FALSE" Indexed="FALSE"></Field>
          </pnp:Fields>
        </pnp:ListInstance>
        <pnp:ListInstance Title="IP Catalog" Description="Delivery IPs and their owning community (build-once, share-everywhere)." TemplateType="100" Url="Lists/IPCatalog" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Lookup" Name="OwningCommunity" StaticName="OwningCommunity" DisplayName="Owning Community" Required="TRUE" Indexed="TRUE" List="{listid:Communities}" ShowField="Title"></Field>
            <Field Type="Note" Name="Description" StaticName="Description" DisplayName="Description" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"></Field>
          </pnp:Fields>
        </pnp:ListInstance>
        <pnp:ListInstance Title="Health Metrics" Description="Periodic snapshots of the six health measures." TemplateType="100" Url="Lists/HealthMetrics" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Lookup" Name="Community" StaticName="Community" DisplayName="Community" Required="TRUE" Indexed="TRUE" List="{listid:Communities}" ShowField="Title"></Field>
            <Field Type="Choice" Name="Measure" StaticName="Measure" DisplayName="Measure" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Participation</CHOICE><CHOICE>Contribution</CHOICE><CHOICE>Responsiveness</CHOICE><CHOICE>Knowledge reuse</CHOICE><CHOICE>Belonging</CHOICE><CHOICE>Cross-pollination</CHOICE></CHOICES></Field>
            <Field Type="Choice" Name="Period" StaticName="Period" DisplayName="Period" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Baseline</CHOICE><CHOICE>Q2 FY27</CHOICE><CHOICE>Q3 FY27</CHOICE><CHOICE>Year-end FY27</CHOICE></CHOICES></Field>
            <Field Type="Number" Name="Value" StaticName="Value" DisplayName="Value" Required="TRUE" Indexed="FALSE"></Field>
            <Field Type="Choice" Name="Unit" StaticName="Unit" DisplayName="Unit" Required="TRUE" Indexed="FALSE"><CHOICES><CHOICE>Percent</CHOICE><CHOICE>count</CHOICE><CHOICE>hours</CHOICE><CHOICE>score</CHOICE></CHOICES></Field>
            <Field Type="Boolean" Name="IsBaseline" StaticName="IsBaseline" DisplayName="Is Baseline" Required="FALSE" Indexed="FALSE"></Field>
            <Field Type="Note" Name="Commentary" StaticName="Commentary" DisplayName="Commentary" Required="FALSE" Indexed="FALSE" NumLines="6" RichText="FALSE"></Field>
          </pnp:Fields>
        </pnp:ListInstance>
        <pnp:ListInstance Title="Forum Retirement" Description="Consolidation register and reduction tracking; one item per legacy forum." TemplateType="100" Url="Lists/ForumRetirement" EnableVersioning="true" EnableAttachments="false">
          <pnp:Fields>
            <Field Type="Choice" Name="Disposition" StaticName="Disposition" DisplayName="Disposition" Required="TRUE" Indexed="TRUE"><CHOICES><CHOICE>Migrate</CHOICE><CHOICE>Merge</CHOICE><CHOICE>Close</CHOICE></CHOICES></Field>
            <Field Type="Lookup" Name="TargetCommunity" StaticName="TargetCommunity" DisplayName="Target Community" Required="TRUE" Indexed="TRUE" List="{listid:Communities}" ShowField="Title"></Field>
            <Field Type="DateTime" Name="CompletionDate" StaticName="CompletionDate" DisplayName="Completion Date" Required="FALSE" Indexed="FALSE" Format="DateOnly"></Field>
          </pnp:Fields>
        </pnp:ListInstance>
      </pnp:Lists>
    </pnp:ProvisioningTemplate>
  </pnp:Templates>
</pnp:Provisioning>
