{
  "name": "ssd-communities-portal",
  "version": "1.0.0",
  "private": true,
  "description": "SharePoint Framework portal for SSD Technical Communities governance.",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "scripts": {
    "build": "gulp bundle",
    "bundle:ship": "gulp bundle --ship",
    "clean": "gulp clean",
    "lint": "gulp lint",
    "package:ship": "gulp package-solution --ship",
    "provision:generate": "node scripts/generate-provisioning.js",
    "serve": "gulp serve",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "validate:core": "node scripts/validate-core.js",
    "validate": "npm run provision:generate && npm run validate:core && npm run lint && npm test && npm run bundle:ship && npm run package:ship"
  },
  "dependencies": {
    "@fluentui/react": "8.106.4",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-http": "1.21.1",
